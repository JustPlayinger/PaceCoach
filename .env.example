# ===== PaceCoach 环境变量示例（复制为 .env 后填写） =====

# SQLite 数据库文件路径（Prisma）
DATABASE_URL="file:./db/custom.db"

# DeepSeek API Key（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek 官方 API 地址（文本对话/点评/课表生成）
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# DeepSeek 无多模态能力：识图请求转发到本地 DsBridge 多模态网关
# （https://github.com/JustPlayinger/ds-multimodal-bridge，图片→OCR/视觉模型→文本→DeepSeek）
# 若网关不可达，应用会自动降级到内置 OCR（tesseract.js）
DEEPSEEK_VISION_API_URL=http://127.0.0.1:8901/v1/chat/completions
